Bolum Input Deck
User must define diameter, velocity, theta_deg, init_strength, and density for the code to run
diameter            = 1.6        # meters
velocity            = 18775.0    # entry velocity in m/s (ranges from 11200 to ~70000)
theta_deg           = 20.        # degrees from the horizontal
init_strength       = 1.8e5     # mat: iron=1.e7, chondrite=1.e5, carbonaceous=1.e4, cometary=1.e3
density             = 3000.0     # kg/m^3




