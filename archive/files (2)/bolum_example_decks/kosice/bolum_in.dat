Kosice 2010 (Borovicka+2013 MAPS)  -- bolum v2 input deck
format:  key = value   # comment   (first two lines are skipped)
diameter       = 1.25       # m   (3500 kg at 3400 kg/m^3)
velocity       = 15000.0    # m/s
theta_deg      = 60.0       # deg
q_factor       = 1.0        # published strengths use p = rho*v^2 (this code's default is 0.5*rho*v^2)
init_strength  = 1.0e5      # Pa  first breakup at ~0.1 MPa
strength_secondary = 1.0e6  # Pa  second stage: heavy fragmentation near 1 MPa
density        = 3400.0     # kg/m^3
